# ============================================================
# OneGate 环境变量示例
# 用法：复制为 .env，按注释填写；不填的项使用默认值。
#   cp .env.example .env
# 注意：.env 已在 .gitignore 中，永远不要提交。
# ============================================================

# --- 监听地址与端口 ---
# 默认只监听本机，由 nginx 反向代理对外；不要直接暴露到公网。
HOST=127.0.0.1
PORT=8787

# --- 数据目录 ---
# 通道密钥、账户、调用记录、审计日志都写入这里（自动建目录，权限 0700）。
# 备份这个目录就等于备份整个网关。
DATA_DIR=./data

# --- 管理员密钥 ---
# 控制台登录用。留空则首次启动自动生成，写入 DATA_DIR/admin.key 并在终端打印一次。
# 建议用随机长字符串：openssl rand -base64 32
RELAY_ADMIN_KEY=

# --- 对外地址 ---
# 客户侧站点地址（充值、账户、接口文档所在域名），必须与浏览器访问地址一致。
PUBLIC_ORIGIN=https://example.com
# 管理控制台地址；与 PUBLIC_ORIGIN 相同也可以。
ADMIN_ORIGIN=https://admin.example.com
# 若整个网关挂在反向代理的子路径（如 https://example.com/gateway），在此填写 "/gateway"，否则留空。
PUBLIC_BASE_PATH=

# --- Cookie ---
# 默认 true（HTTPS 下必须 true）。只在纯 HTTP 的本地临时测试时可设为 false。
COOKIE_SECURE=true

# --- 调用记录 ---
# 保留的最大记录条数（超出后淘汰最旧记录）。
RELAY_CALL_ROWS=20000
# 调用记录保留天数。
RELAY_CALL_RETENTION_DAYS=90

# --- 邮箱验证码有效期（秒） ---
PORTAL_CODE_TTL_SECONDS=600
